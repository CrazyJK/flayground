# EditorConfig — https://editorconfig.org
root = true

# ──── 공통 기본값 ────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true

# ──── Python (flay-ai) ───────────────────────────────────────
# ruff / black 기준: indent 4, max line 100
[*.py]
indent_size     = 4
max_line_length = 100

# ──── TypeScript / JavaScript ────────────────────────────────
[*.{ts,tsx,js,jsx,mjs,cjs}]
max_line_length = 100

# ──── 마크업 / 설정 파일 ─────────────────────────────────────
[*.{json,jsonc,yaml,yml,toml,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ──── 배치 / 셸 스크립트 ────────────────────────────────────
[*.{bat,cmd}]
end_of_line = crlf

[*.{sh,ps1}]
end_of_line = lf
