{
  "version": "2.0.0",
  "tasks": [
    // ── flay-ai: Qdrant (docker compose up -d, 즉시 반환) ──
    {
      "label": "ai qdrant: start",
      "type": "shell",
      "command": "docker compose up -d qdrant",
      "options": { "cwd": "${workspaceFolder}/flay-ai" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    // ── flay-ai: Ollama (Windows 서비스로 이미 실행 중이면 에러 발생하지만 무시 가능) ──
    {
      "label": "ai ollama: serve",
      "type": "shell",
      "command": "ollama serve",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": ".", "file": 1, "location": 2, "message": 3 },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "Listening on" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── flay-ai: FastAPI (uvicorn --reload) ──
    {
      "label": "ai api: dev",
      "type": "shell",
      "command": "${workspaceFolder}\\flay-ai\\.venv\\Scripts\\python.exe -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": { "cwd": "${workspaceFolder}/flay-ai" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": ".", "file": 1, "location": 2, "message": 3 },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "Application startup complete" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── flay-ai: Next.js 개발서버 ──
    {
      "label": "ai web: dev",
      "type": "shell",
      "command": "yarn dev",
      "options": { "cwd": "${workspaceFolder}/flay-ai/apps/web" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": ".", "file": 1, "location": 2, "message": 3 },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "Ready in" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── flay-ai 전체 동시 기동 (Ollama 는 상시 서비스라 제외) ──
    {
      "label": "ai all: dev start",
      "dependsOn": ["ai qdrant: start", "ai api: dev", "ai web: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
