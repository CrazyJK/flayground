{
  "search.exclude": {
    "**/dependencies-viewer.json": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/*.log": true,
    ".archive": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true
    // "**/*.js.map": true,
    // "**/dist": true
  },
  "files.associations": {
    "*.ts": "typescript"
  },
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "emmet.includeLanguages": {
    "typescript": "html"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.scss, ${capture}.html, ${capture}.md",
    "*.js": "${capture}.js.map, ${capture}.html, ${capture}.css, ${capture}.css.map, ${capture}.json",
    "*.css": "${capture}.css.map",
    "webpack.common.cjs": "webpack.*.cjs"
  },
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.paths": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.format.enabled": false,
  "eslint.validate": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
  "eslint.options": {
    "resolvePluginsRelativeTo": "./flay-web/frontend"
  },
  "eslint.workingDirectories": [
    { "directory": "flay-ai/apps/web", "changeProcessCWD": true }
  ],
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // ── Python (flay-ai): Black 포맷터 + Ruff 린터 ─────────────
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "black-formatter.args": ["--line-length", "100"],
  "python.defaultInterpreterPath": "${workspaceFolder}/flay-ai/.venv/Scripts/python.exe",
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  // 내장 사전을 파일 타입과 무관하게 전역으로 활성화 — .md/.yaml/.ps1 에서도 python·npm 용어(venv, uvicorn, tsup …)를 인식.
  // 어떤 내장 사전에도 없는 프로젝트 고유어(qdrant, Ollama, Flayground …)만 커스텀 사전에 추가한다.
  "cSpell.dictionaries": [
    "python",
    "node",
    "npm",
    "typescript",
    "html",
    "css",
    "fonts",
    "powershell",
    "bash",
    "docker",
    "sql",
    "fullstack",
    "data-science"
  ],
  "cSpell.customDictionaries": {
    "custom-dictionary-workspace": {
      "name": "custom-dictionary-workspace",
      "path": "${workspaceFolder:flayground}/.cspell/custom-dictionary-workspace.txt",
      "addWords": true,
      "scope": "workspace"
    }
  }
}
