{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-favicon.js",
    "dev": "next dev -H ai.kamoru.jk -p 3000 --experimental-https --experimental-https-key ../../../.cert/kamoru.jk.key --experimental-https-cert ../../../.cert/kamoru.jk.pem",
    "prebuild": "node scripts/ensure-favicon.js",
    "build": "node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && next build",
    "start": "node server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
