# Google Gemini API 키 (없으면 Gemini 모델 비활성화)
GEMINI_API_KEY=

# 외부 OpenAI 호환 API (OpenRouter 등). 세 값이 모두 있어야 활성화.
# 모델 ID 는 해당 서비스 표기 그대로, 쉼표 구분. 첫 항목이 기동 시 검증에 쓰인다.
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free

# 로컬 Ollama OpenAI 호환 엔드포인트 (없으면 로컬 모델 비활성화)
LOCAL_AI_ENDPOINT=http://127.0.0.1:11434/v1
# 로컬 제공자용 더미 API 키 (Ollama는 무시, 비워두면 'ollama')
LOCAL_AI_API_KEY=ollama

# MCP 서버 설정 (선택)
MCP_SERVER_NAME=nexus-server
MCP_SERVER_VERSION=1.0.0

# HTTP 서버 포트 (선택, 기본값: 3002)
PORT=3002
